# Copie para .env para rodar com Docker/dev
WEB_PORT_HOST=3080

# Gere com: openssl rand -hex 32
AUTH_SECRET=

# URL do app como o navegador a enxerga (Auth.js)
AUTH_URL=http://localhost:3080
AUTH_TRUST_HOST=true

# API de futebol chamada pelo servidor do Next (nunca pelo navegador).
# A chave de acesso de cada usuário é digitada no login e fica só no cookie criptografado.
API_FOOTBALL_URL=https://v3.football.api-sports.io
